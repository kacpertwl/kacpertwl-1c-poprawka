<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="700"
        Width="540" Height="700"
        WindowStartupLocation="CenterScreen"
        x:Class="kacpertwl_1c_poprawka.MainWindow"
        Title="Minutnik Pomodoro"
        Background="#181824">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Nagłówek -->
        <TextBlock Grid.Row="0"
                   Text="Minutnik Pomodoro"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#FFFFFF"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16" />

        <!-- Karta z odliczaniem czasu i licznikiem cykli -->
        <Border Grid.Row="1"
                Background="#232334"
                CornerRadius="16"
                Padding="24"
                Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <TextBlock x:Name="StatusText"
                           Text="Tryb: Praca"
                           FontSize="16"
                           FontWeight="Medium"
                           Foreground="#A5B4FC"
                           HorizontalAlignment="Center" />

                <!-- Czas i licznik cykli widoczny obok -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                    <TextBlock x:Name="TimerText"
                               Text="25:00"
                               FontSize="56"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               VerticalAlignment="Center" />

                    <Border Background="#2E2E44"
                            CornerRadius="10"
                            Padding="14,10"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CycleCountText"
                                   Text="Cykle: 0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#F1F5F9"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Zmiana długości pracy i przerwy w oknie -->
        <Border Grid.Row="2"
                Background="#232334"
                CornerRadius="16"
                Padding="18,16"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Czas pracy (min):"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#CBD5E1" />
                    <NumericUpDown x:Name="WorkDurationInput"
                                   Value="25"
                                   Minimum="1"
                                   Maximum="180"
                                   Increment="1"
                                   FormatString="0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="Czas przerwy (min):"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#CBD5E1" />
                    <NumericUpDown x:Name="BreakDurationInput"
                                   Value="5"
                                   Minimum="1"
                                   Maximum="60"
                                   Increment="1"
                                   FormatString="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Przyciski start/pauza oraz reset -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Margin="0,0,0,16">
            <Button x:Name="StartPauseButton"
                    Content="Start"
                    Width="140"
                    Height="44"
                    FontSize="16"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#10B981"
                    Foreground="#FFFFFF"
                    CornerRadius="10" />

            <Button x:Name="ResetButton"
                    Content="Reset"
                    Width="140"
                    Height="44"
                    FontSize="16"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#EF4444"
                    Foreground="#FFFFFF"
                    CornerRadius="10" />
        </StackPanel>

        <!-- Blok „Własną ręką: lista” - Historia skończonych cykli -->
        <Border Grid.Row="4"
                Background="#232334"
                CornerRadius="16"
                Padding="18,16">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="Historia ukończonych cykli:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"
                           Margin="0,0,0,10" />

                <ListBox Grid.Row="1"
                         x:Name="CycleHistoryListBox"
                         Background="#181824"
                         CornerRadius="8"
                         MinHeight="120"
                         Foreground="#F1F5F9" />
            </Grid>
        </Border>
    </Grid>
</Window>
